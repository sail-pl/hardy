guarantees G ({valid} -> {data <= 100})
node C1 receives (raw : int) returns (data : int, valid : bool) {
    loop {
        data := raw * 2;
        valid := (data <= 50);
    }
}


assumes G ({valid} -> {data <= 100})
guarantees G ({valid} -> {safe_out = data})
guarantees G ({!valid} -> {safe_out = 0})
node C2 receives (data : int, valid : bool) returns (safe_out : int) {
    loop {
        if (valid) {
            safe_out := data;
        } else {
            safe_out := 0;
        }
    }
}

guarantees G {safe_out <= 100}
node Main receives (raw : int) returns (safe_out : int) { 
    instances c1 : C1, c2 : C2

    loop {
        safe_out := c2(c1(raw))
    }
}
